---
import Layout from "../../layouts/Layout.astro";
import { getAgents } from "../../backend.mjs";

const agents = await getAgents();
---

<Layout titre="Agents — ImmoPlus">
    <h1 class="text-2xl font-bold text-slate-900 mb-6">Nos agents</h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
            agents.map((agent) => (
                <div class="bg-white border border-slate-200 rounded-lg p-5 flex flex-col gap-2">
                    <p class="font-semibold text-slate-900">
                        {agent.prenom.trim()} {agent.nom.trim()}
                    </p>
                    <p class="text-slate-500 text-sm">{agent.email}</p>
                    <a
                        href={`/agents/${agent.id}`}
                        class="mt-2 inline-block bg-blue-600 text-white text-sm px-4 py-2 rounded hover:bg-blue-700 transition-colors text-center"
                    >
                        Voir ses offres
                    </a>
                </div>
            ))
        }
    </div>
</Layout>
