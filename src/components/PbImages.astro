---
import { getImageUrl } from "../backend.mjs";

const { record, recordImage = "Images" } = Astro.props;
const url = getImageUrl(record, recordImage);
---

{
    url ? (
        <img
            src={url}
            alt={record.nomMaison}
            class="w-full h-48 object-cover rounded-t-lg"
        />
    ) : (
        <div class="w-full h-48 bg-slate-200 rounded-t-lg flex items-center justify-center">
            <span class="text-slate-400 text-sm">Aucune image</span>
        </div>
    )
}
