---
import Layout from "../../layouts/Layout.astro";
import OffreCard from "../../components/OffreCard.astro";
import { getAgent, getOffresByAgent } from "../../backend.mjs";

const { id } = Astro.params;
const agent = await getAgent(id);
const offres = await getOffresByAgent(agent?.relation ?? []);
---

<Layout
    titre={agent
        ? `Offres de ${agent.prenom.trim()} ${agent.nom.trim()} — ImmoPlus`
        : "Agent — ImmoPlus"}
>
    <a
        href="/agents"
        class="text-sm text-slate-600 hover:text-blue-600 mb-6 inline-block"
        >← Retour aux agents</a
    >
    {
        agent && (
            <h1 class="text-2xl font-bold text-slate-900 mb-6">
                Offres de {agent.prenom.trim()} {agent.nom.trim()}
            </h1>
        )
    }
    {
        offres.length === 0 ? (
            <p class="text-slate-500">Cet agent n'a pas encore d'offres.</p>
        ) : (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {offres.map((offre) => (
                    <OffreCard offre={offre} />
                ))}
            </div>
        )
    }
</Layout>
